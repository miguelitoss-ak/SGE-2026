// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senha  String
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model Curso {
  id                Int     @id @default(autoincrement())
  nome              String
  carga_horaria     Int
  email_coordenacao String?

  alunos Aluno[]

  @@map("cursos")
}

model UsuarioEmpresa {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  telefone  String?
  createdAt DateTime @default(now()) @map("created_at")

  empresas Empresa[]

  @@map("usuario_empresa")
}

model Empresa {
  id                 Int     @id @default(autoincrement())
  CNPJ_NibocoProd    String  @unique @db.Char(14)
  nome_social        String
  nome_fantasia      String?
  endereco           String?
  telefone           String?
  email              String?
  representante      String?
  cargo              String?
  inscricao_estadual String? @db.VarChar(8)
  id_usuario_empresa Int?

  usuarioEmpresa UsuarioEmpresa? @relation(fields: [id_usuario_empresa], references: [id], onDelete: SetNull)
  supervisores   Supervisor[]
  estagios       Estagio[]

  @@map("empresas")
}

model Orientador {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String?
  telefone String?

  estagios Estagio[] @relation("EstagioOrientador")
  alunos   Aluno[]   @relation("AlunoOrientador")

  @@map("orientadores")
}

model DocumentosModelo {
  id                           Int    @id @default(autoincrement())
  termo_de_compromisso         String?
  plano_de_estagio             String?
  ficha_de_avaliacao_empresa   String?
  ficha_de_avaliacao_aluno     String?

  documentos_estagio DocumentosEstagio[]

  @@map("documentos_modelo")
}

model Aluno {
  id             Int       @id @default(autoincrement())
  matricula      Int       @unique
  nome           String
  cpf            String    @unique
  telefone       String?
  email          String?
  data_nasc      DateTime? @db.Date
  id_curso       Int
  id_orientador  Int?

  curso      Curso       @relation(fields: [id_curso], references: [id], onDelete: Restrict)
  orientador Orientador? @relation("AlunoOrientador", fields: [id_orientador], references: [id], onDelete: SetNull)
  estagios   Estagio[]

  @@map("alunos")
}

model Supervisor {
  id         Int    @id @default(autoincrement())
  nome       String
  cpf        String @unique
  cargo      String?
  telefone   String?
  email      String?
  id_empresa Int

  empresa  Empresa @relation(fields: [id_empresa], references: [id], onDelete: Restrict)
  estagios Estagio[]

  @@map("supervisores")
}

model DocumentosEstagio {
  id                         Int     @id @default(autoincrement())
  termo_de_compromisso       String?
  ficha_de_avaliacao_empresa String?
  ficha_de_avaliacao_aluno   String?
  id_documentos_modelo       Int?

  modelo   DocumentosModelo? @relation(fields: [id_documentos_modelo], references: [id], onDelete: SetNull)
  estagios Estagio[]

  @@map("documentos_estagio")
}

model Estagio {
  id                    Int      @id @default(autoincrement())
  dt_registro           DateTime @db.Date
  beneficio_alimentacao Boolean?
  beneficio_transporte  Boolean?
  beneficio_impresso    Boolean?
  bolsa_auxilio         Decimal? @db.Decimal(10, 2)
  data_inicio           DateTime @db.Date
  data_fim              DateTime? @db.Date
  dt_rescisao           DateTime? @db.Date
  dt_renovacao          DateTime? @db.Date
  carga_horaria_total   Int?
  carga_horaria_semanal  Int?
  situacao              String
  id_aluno               Int
  id_empresa             Int
  id_supervisor          Int?
  id_orientador          Int
  id_documento           Int?

  aluno       Aluno @relation(fields: [id_aluno], references: [id], onDelete: Restrict)
  empresa     Empresa @relation(fields: [id_empresa], references: [id], onDelete: Restrict)
  supervisor  Supervisor? @relation(fields: [id_supervisor], references: [id], onDelete: Restrict)
  orientador  Orientador @relation("EstagioOrientador", fields: [id_orientador], references: [id], onDelete: Restrict)
  documento   DocumentosEstagio? @relation(fields: [id_documento], references: [id], onDelete: Restrict)

  dias_semana_estagio DiaSemanaEstagio[]

  @@map("estagios")
}

model DiaSemanaEstagio {
  id              Int      @id @default(autoincrement())
  horario_inicio DateTime @db.Time
  horario_saida  DateTime @db.Time
  id_estagio     Int
  dia_semana     DiaSemana

  estagio Estagio @relation(fields: [id_estagio], references: [id], onDelete: Cascade)

  @@map("dia_semana_estagio")
}
